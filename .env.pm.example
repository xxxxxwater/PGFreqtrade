# Copy to .env and fill in real values. Never commit real secrets.
# Used by: docker compose -f docker-compose-pm.yml --env-file .env up -d
BINANCE_PM_API_KEY=FILL_ME_IN
BINANCE_PM_API_SECRET=FILL_ME_IN

# PostgreSQL (docker-compose-pm-prod.yml only)
PG_USER=freqtrade
PG_PASSWORD=FILL_ME_IN_STRONG_PASSWORD
PG_DB=freqtrade

# Optional: override with the exact PM risk/recv-window tuning if needed
# FREQTRADE__EXCHANGE__PORTFOLIO_MARGIN__RECV_WINDOW=10000
