{
  "name": "PGFreqtrade Coinbase Advanced Test Dev",
  "image": "ghcr.io/freqtrade/freqtrade-devcontainer:latest",
  "forwardPorts": [8080, 8082, 8083, 8010, 8011],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/freqtrade,type=bind,consistency=cached",
  "remoteUser": "ftuser",
  "onCreateCommand": "pip install --user -e .",
  "postCreateCommand": "freqtrade create-userdir --userdir user_data/ || true",
  "workspaceFolder": "/workspaces/freqtrade",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash",
        "editor.insertSpaces": true,
        "files.trimTrailingWhitespace": true,
        "[markdown]": {
          "files.trimTrailingWhitespace": false
        },
        "python.pythonPath": "/usr/local/bin/python",
        "[python]": {
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          },
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "davidanson.vscode-markdownlint",
        "ms-azuretools.vscode-docker",
        "vscode-icons-team.vscode-icons",
        "github.vscode-github-actions"
      ]
    }
  }
}
