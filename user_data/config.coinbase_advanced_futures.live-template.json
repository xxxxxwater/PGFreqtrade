{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "PGTrading-Coinbase-Advanced-Futures-LiveTemplate",
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "stake_currency": "USDC",
  "stake_amount": 50,
  "tradable_balance_ratio": 0.90,
  "max_open_trades": 2,
  "fiat_display_currency": "USD",
  "dry_run": false,
  "strategy": "CoinbaseAdvancedFuturesVWAP",
  "strategy_path": "user_data/strategies",
  "timeframe": "5m",
  "exchange": {
    "name": "coinbase",
    "key": "organizations/REPLACE/apiKeys/REPLACE",
    "secret": "-----BEGIN EC PRIVATE KEY-----\\nREPLACE\\n-----END EC PRIVATE KEY-----\\n",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "swap",
        "defaultSubType": "linear",
        "adjustForTimeDifference": true,
        "portfolio": "0195cbef-1284-7a43-8c98-9a0a1dcec6ff"
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 3000,
      "options": {
        "defaultType": "swap",
        "defaultSubType": "linear",
        "portfolio": "0195cbef-1284-7a43-8c98-9a0a1dcec6ff"
      }
    },
    "pair_whitelist": [
      "BTC/USDC:USDC",
      "ETH/USDC:USDC",
      "SOL/USDC:USDC"
    ],
    "pair_blacklist": []
  },
  "order_types": {
    "entry": "market",
    "exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8011,
    "verbosity": "error",
    "enable_openapi": true,
    "jwt_secret_key": "replace-me",
    "ws_token": "replace-me",
    "username": "replace-me",
    "password": "replace-me"
  }
}
